// ─────────────────────────────────────────────────────────────────────────
// DIAMONDVA.Co — Prisma schema
// PostgreSQL (Supabase, connection pooling vía PgBouncer)
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer, puerto 6543, ?pgbouncer=true) — runtime
  directUrl = env("DIRECT_URL") // directa (puerto 5432) — usada por Prisma Migrate
}

// ── ENUMS ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
}

enum Material {
  ORO_18K
  ORO_BAJO
  ENCHAPADO
  PLATA_925
}

enum PricingMode {
  FIXED
  BY_WEIGHT
}

enum ShippingMethod {
  ENVIO_DOMICILIO
  SUCURSAL_CORREO
  RETIRO_LOCAL
}

enum PaymentMethod {
  MERCADO_PAGO
  TRANSFERENCIA
  EFECTIVO
}

enum PaymentStatus {
  PENDING
  APPROVED
  IN_PROCESS
  REJECTED
  REFUNDED
  CANCELLED
}

enum OrderStatus {
  NUEVO
  CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum CouponType {
  PERCENT
  FIXED
}

// ── USUARIOS Y AUDITORÍA ────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  auditLogs AuditLog[]

  @@index([role])
  @@index([deletedAt])
}

/// Registro de toda acción relevante del admin: quién cambió qué y cuándo.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // ej: "PRODUCT_UPDATE", "GOLD_PRICE_CHANGE", "ORDER_STATUS_CHANGE"
  entity    String // ej: "Product", "Order", "Setting"
  entityId  String
  changes   Json // diff { before, after }
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ── CATÁLOGO ─────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?    @db.Text
  imageUrl    String?
  icon        String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([parentId])
  @@index([isActive, order])
  @@index([deletedAt])
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String? @db.Text
  sku         String  @unique

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  material    Material
  pricingMode PricingMode

  // FIXED
  price Decimal? @db.Decimal(12, 2)

  // BY_WEIGHT — precioFinal = weightGrams * goldPricePerGram(material) + laborCost
  weightGrams Decimal? @db.Decimal(10, 3)
  laborCost   Decimal? @db.Decimal(12, 2)

  compareAtPrice Decimal? @db.Decimal(12, 2) // tachado, solo liquidación
  cost           Decimal? @db.Decimal(12, 2) // costo interno — NUNCA exponer al público

  stock         Int     @default(0)
  lowStockAlert Int     @default(3)
  trackStock    Boolean @default(true)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  order      Int     @default(0)
  views      Int     @default(0)

  metaTitle       String?
  metaDescription String?

  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId, isActive, deletedAt])
  @@index([material])
  @@index([isFeatured, isActive])
  @@index([pricingMode])
  @@index([deletedAt])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // ej: "45cm", "Talle 16"
  sku         String   @unique
  priceDelta  Decimal  @default(0) @db.Decimal(12, 2)
  weightGrams Decimal? @db.Decimal(10, 3)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([productId])
}

/// Cuenta de cliente de la tienda (storefront) — totalmente separada de
/// `User` (panel admin). Un cliente logueado que compra sin usar cupón
/// recibe 5% de descuento automático (ver `Order.memberDiscountApplied`).
model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  orders Order[]

  @@index([deletedAt])
}

// ── PEDIDOS ──────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(uuid()) @db.Uuid
  // Serial de Postgres — atómico bajo concurrencia, a diferencia de un
  // count()+1. orderNumber se deriva de acá ("DVA-" + padded) recién
  // después del insert, en la misma transacción.
  orderSeq    Int    @unique @default(autoincrement())
  orderNumber String @unique // DVA-000123
  publicCode  String @unique // /seguimiento/[code], sin login

  customerName  String
  customerEmail String
  customerPhone String
  customerDni   String?

  // Cuenta de cliente opcional (checkout sigue funcionando como invitado
  // sin loguearse). Si está logueado y no usó cupón, se aplica el 5% de
  // socio automático — ver `memberDiscountApplied`.
  customerId            String?   @db.Uuid
  customer              Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  memberDiscountApplied Boolean   @default(false)

  shippingMethod  ShippingMethod
  shippingAddress Json? // { street, number, floor?, city, province, postalCode, notes? }
  shippingCost    Decimal        @db.Decimal(12, 2)

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  couponId   String? @db.Uuid
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String? // snapshot: se sigue mostrando aunque el cupón se borre/desactive

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(NUEVO)

  mpPaymentId       String?
  mpPreferenceId    String?
  mpMerchantOrderId String?

  trackingCode  String?
  internalNotes String? @db.Text
  customerNotes String? @db.Text

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentStatus])
  @@index([orderStatus, createdAt])
  @@index([customerEmail])
  @@index([mpPaymentId])
  @@index([createdAt])
}

/// Snapshot histórico: los datos del producto/precio quedan congelados
/// al momento de la compra, aunque el producto cambie o se desactive después.
model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?         @db.Uuid
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  productSku  String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  unitCost    Decimal? @db.Decimal(12, 2) // snapshot de Product.cost — margen histórico

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ── MARKETING / CONTENIDO ───────────────────────────────────────────────

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(12, 2)
  minPurchase Decimal?   @db.Decimal(12, 2)
  maxUses     Int?
  usedCount   Int        @default(0)
  validFrom   DateTime
  validUntil  DateTime
  isActive    Boolean    @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, validFrom, validUntil])
}

model Banner {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  order          Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, order])
}

/// Barra de anuncios rotativa superior del home.
model Announcement {
  id        String   @id @default(uuid()) @db.Uuid
  text      String
  linkUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

/// Configuración global editable desde el admin sin deploy. Claves esperadas:
/// goldPricePerGram18k, goldPricePerGramLow, storeName, logoUrl, whatsapp,
/// email, address, instagram, facebook, businessHours, shippingRates,
/// freeShippingThreshold, transferDiscountPercent, installmentsEnabled,
/// installmentsCount, heroTitle, heroSubtitle, aboutText,
/// whatsappOrderTemplate, maintenanceMode.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}
